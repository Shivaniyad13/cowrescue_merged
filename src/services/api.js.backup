export const verifyAdminOrgBankDetails = async (token, id, statusOrData, note = "") => {
  const payload = typeof statusOrData === "object" ? statusOrData : { status: statusOrData, note };
  const response = await fetch(`${API_BASE_URL}/cow-rescue/admin/organizations/${id}/bank-details/verify`, {
    method: "PATCH",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${token}`,
    },
    body: JSON.stringify(payload),
  });

  const result = await response.json();
  if (!response.ok) {
    throw new Error(result.message || "Failed to verify bank details.");
  }
  return result;
};

