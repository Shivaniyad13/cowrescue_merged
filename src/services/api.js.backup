// -------------------------------------------------------------
// CERTIFICATE & IMPACT APIs (Phase 4D)
// -------------------------------------------------------------
export const getPublicCertificateVerification = async (certificateId) => {
  const response = await fetch(`${API_BASE_URL}/cow-rescue/certificates/verify/${certificateId}`);
  const result = await response.json();
  return result; // return full result object to handle VERIFIED, REVOKED, and NOT_FOUND statuses gracefully
};

export const getCertificateDetails = async (certificateId) => {
