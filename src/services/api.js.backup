  if (!response.ok) throw new Error(result.message || "Failed to fetch financial summary.");
  return result;
};

export const getAdminFinancialContributions = async (token, status = "ALL", search = "") => {
  const query = new URLSearchParams({ status, search }).toString();
  const response = await fetch(`${API_BASE_URL}/cow-rescue/admin/financials/contributions?${query}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const result = await response.json();
  if (!response.ok) throw new Error(result.message || "Failed to fetch financial contributions.");
  return result;
};

